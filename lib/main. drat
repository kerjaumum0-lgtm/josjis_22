// ==================== DEVICE TAB ====================
class DevicePage extends StatefulWidget {
  final String ip, user, pass;
  const DevicePage({
    super.key,
    required this.ip,
    required this.user,
    required this.pass,
  });

  @override
  State<DevicePage> createState() => _DevicePageState();
}

class _DevicePageState extends State<DevicePage> {
  List devices = [];
  bool loading = true;

  @override
  void initState() {
    super.initState();
    fetchDevices();
  }

  Future<void> fetchDevices() async {
    setState(() => loading = true);
    try {
      final response = await http.get(
        Uri.parse('http://${widget.ip}:8728/rest/ip/dhcp-server/lease'),
        headers: {
          'Authorization':
              'Basic ${base64Encode(utf8.encode('${widget.user}:${widget.pass}'))}',
        },
      );
      if (response.statusCode == 200) {
        setState(() {
          devices = json.decode(response.body);
          loading = false;
        });
      }
    } catch (e) {
      setState(() => loading = false);
    }
  }

  String getStatus(String? address) {
    if (address == null) return 'Putus';
    if (address.contains('.')) return 'Baik';
    return 'Kurang Balik';
  }

  Color getStatusColor(String status) {
    switch (status) {
      case 'Baik':
        return Colors.green;
      case 'Kurang Balik':
        return Colors.orange;
      case 'Buruk':
        return Colors.red;
      default:
        return Colors.grey;
    }
  }

  @override
  Widget build(BuildContext context) {
    return RefreshIndicator(
      onRefresh: fetchDevices,
      child: loading
          ? const Center(child: SpinKitFadingGrid(color: Colors.deepPurple))
          : ListView.builder(
              padding: const EdgeInsets.all(10),
              itemCount: devices.length,
              itemBuilder: (context, i) {
                final d = devices[i];
                final status = getStatus(d['address']);
                return Card(
                  child: ListTile(
                    leading: CircleAvatar(
                      backgroundColor: getStatusColor(status),
                      child: Text(
                        d['host-name']?.substring(0, 1) ?? '?',
                        style: const TextStyle(color: Colors.white),
                      ),
                    ),
                    title: Text(d['host-name'] ?? 'No HostName'),
                    subtitle: Text(
                        '${d['address'] ?? 'N/A'} · ${d['mac-address'] ?? 'N/A'}'),
                    trailing: Column(
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: [
                        Container(
                          padding: const EdgeInsets.symmetric(
                            horizontal: 8,
                            vertical: 2,
                          ),
                          decoration: BoxDecoration(
                            color: getStatusColor(status).withOpacity(0.2),
                            borderRadius: BorderRadius.circular(10),
                          ),
                          child: Text(
                            status,
                            style: const TextStyle(fontSize: 12),
                          ),
                        ),
                        Text(
                          '${(i + 1) * 20} ms',
                          style: const TextStyle(fontSize: 10),
                        ),
                      ],
                    ),
                  ),
                );
              },
            ),
    );
  }
}

// ==================== WIFI TAB ====================
class WifiPage extends StatefulWidget {
  final String ip, user, pass;
  const WifiPage({
    super.key,
    required this.ip,
    required this.user,
    required this.pass,
  });

  @override
  State<WifiPage> createState() => _WifiPageState();
}

class _WifiPageState extends State<WifiPage> {
  final TextEditingController ssidController = TextEditingController(text: 'JOSJIS');
  final TextEditingController passController = TextEditingController(text: 'josjis123');
  bool wifiOn = true;
  bool loading = false;

  Future<void> saveWifi() async {
    setState(() => loading = true);
    try {
      final response = await http.put(
        Uri.parse('http://${widget.ip}:8728/rest/interface/wireless/set/0'),
        headers: {
          'Authorization':
              'Basic ${base64Encode(utf8.encode('${widget.user}:${widget.pass}'))}',
          'Content-Type': 'application/json',
        },
        body: json.encode({
          'ssid': ssidController.text,
          'wpa2-pre-shared-key': passController.text,
        }),
      );

      if (response.statusCode == 200 || response.statusCode == 204) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text('✅ WiFi berhasil diupdate!'),
            backgroundColor: Colors.green,
          ),
        );
      }
    } catch (e) {
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('❌ Gagal: $e'),
          backgroundColor: Colors.red,
        ),
      );
    }
    setState(() => loading = false);
  }

  Future<void> rebootRouter() async {
    showDialog(
      context: context,
      builder: (_) => AlertDialog(
        title: const Text('Reboot Router?'),
        content: const Text('Semua perangkat akan terputus. Lanjutkan?'),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: const Text('Batal'),
          ),
          TextButton(
            onPressed: () async {
              Navigator.pop(context);
              try {
                await http.post(
                  Uri.parse('http://${widget.ip}:8728/rest/system/reboot'),
                  headers: {
                    'Authorization':
                        'Basic ${base64Encode(utf8.encode('${widget.user}:${widget.pass}'))}',
                  },
                );
                ScaffoldMessenger.of(context).showSnackBar(
                  const SnackBar(
                    content: Text('🔄 Reboot sedang berjalan...'),
                    backgroundColor: Colors.orange,
                  ),
                );
              } catch (e) {
                ScaffoldMessenger.of(context).showSnackBar(
                  SnackBar(
                    content: Text('❌ Gagal reboot: $e'),
                    backgroundColor: Colors.red,
                  ),
                );
              }
            },
            child: const Text(
              'Reboot',
              style: TextStyle(color: Colors.red),
            ),
          ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return SingleChildScrollView(
      padding: const EdgeInsets.all(16),
      child: Column(
        children: [
          Card(
            child: Padding(
              padding: const EdgeInsets.all(20),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  const Text(
                    'PENGATURAN WIFI',
                    style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
                  ),
                  const SizedBox(height: 20),
                  TextField(
                    controller: ssidController,
                    decoration: const InputDecoration(
                      labelText: 'Nama WiFi (SSID)',
                      border: OutlineInputBorder(),
                      prefixIcon: Icon(Icons.wifi),
                    ),
                  ),
                  const SizedBox(height: 15),
                  TextField(
                    controller: passController,
                    decoration: const InputDecoration(
                      labelText: 'Password WiFi',
                      border: OutlineInputBorder(),
                      prefixIcon: Icon(Icons.lock),
                    ),
                  ),
                  const SizedBox(height: 20),
                  SizedBox(
                    width: double.infinity,
                    child: ElevatedButton.icon(
                      onPressed: loading ? null : saveWifi,
                      icon: loading
                          ? const SpinKitFadingCircle(size: 20)
                          : const Icon(Icons.save),
                      label: const Text('SIMPAN PERUBAHAN'),
                      style: ElevatedButton.styleFrom(
                        backgroundColor: Colors.deepPurple,
                        foregroundColor: Colors.white,
                        padding: const EdgeInsets.symmetric(vertical: 15),
                        shape: RoundedRectangleBorder(
                          borderRadius: BorderRadius.circular(10),
                        ),
                      ),
                    ),
                  ),
                ],
              ),
            ),
          ),
          const SizedBox(height: 15),
          Card(
            child: Padding(
              padding: const EdgeInsets.all(20),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  const Text(
                    'ROUTER',
                    style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
                  ),
                  const SizedBox(height: 10),
                  ListTile(
                    leading: const Icon(Icons.settings_ethernet),
                    title: const Text('Halaman Pengaturan Router'),
                    subtitle: Text(widget.ip),
                    trailing: const Icon(Icons.open_in_new),
                    onTap: () {},
                  ),
                  const SizedBox(height: 10),
                  SizedBox(
                    width: double.infinity,
                    child: ElevatedButton.icon(
                      onPressed: rebootRouter,
                      icon: const Icon(Icons.restart_alt),
                      label: const Text('REBOOT ROUTER'),
